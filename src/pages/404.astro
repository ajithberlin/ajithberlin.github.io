---
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Page not found — Ajith Berlin</title>
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body>
    <main class="wrap section" style="padding-top: 120px; max-width: 600px;">
      <p class="section-eyebrow">404 / Page Not Found</p>
      <h1 class="hero-title" style="margin-bottom: 16px;">
        Curiosity brought<br />you <span class="serif">here.</span>
      </h1>
      <p style="color: var(--muted); margin-bottom: 24px; font-size: 14px; line-height: 1.7;">
        This page does not exist. There is plenty to explore back at the workspace.
      </p>
      <a href="/" class="btn btn-primary">
        <span>Back to Home</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
      </a>
    </main>
  </body>
</html>
