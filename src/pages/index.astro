---
import '../styles/global.css';
import snapshot from '../data/repos.json';

const repos = snapshot.repos
  .filter(r => r.name !== '.github')
  .sort((a, b) => Number(a.fork) - Number(b.fork) || b.updated_at.localeCompare(a.updated_at));

const originals = repos.filter(r => !r.fork && !r.archived);

const techChips = [
  { name: 'Gemini 2.5', cat: 'ai' },
  { name: 'Claude 3.5', cat: 'ai' },
  { name: 'DeepSeek R1', cat: 'ai' },
  { name: 'Llama 3.3', cat: 'ai' },
  { name: 'ONNX Runtime', cat: 'ai' },
  { name: 'Silero VAD', cat: 'ai' },
  { name: 'Keycloak RHBK', cat: 'cloud' },
  { name: 'AWS & GCP', cat: 'cloud' },
  { name: 'SAML 2.0 / OIDC', cat: 'cloud' },
  { name: 'Swift & Metal', cat: 'lang' },
  { name: 'Rust C-ABI', cat: 'lang' },
  { name: 'Flutter & Dart', cat: 'lang' },
  { name: 'TypeScript', cat: 'lang' },
  { name: 'Python & PyTorch', cat: 'lang' },
  { name: 'FastAPI', cat: 'lang' }
];

const detailedExperience = [
  {
    id: 'basecamp',
    company: 'Base Camp Digital',
    role: 'Middleware Engineer',
    period: 'June 2025 – Present',
    location: 'Singapore',
    badge: 'Enterprise Middleware & AI',
    metrics: ['20+ Enterprise Clients', '2 Realms Topologies', 'Zero-Downtime Migration', 'Agentic AI Enablement'],
    highlights: [
      {
        title: 'Enterprise Keycloak Migration',
        text: 'Spearheaded end-to-end migration from Red Hat SSO (RHSSO) to Red Hat Build of Keycloak (RHBK), managing 20+ enterprise RHBK clients across dual-realm topologies.'
      },
      {
        title: 'Production Infrastructure Maintenance',
        text: 'Handled mission-critical middleware maintenance and L2/L3 production support tickets, diagnosing distributed system issues with zero unplanned service disruption.'
      },
      {
        title: 'Internal AI Enablement & Training',
        text: 'Collaborated cross-functionally to support colleagues with legacy Crystal Reports module stability and led internal AI enablement and agentic workflow training to accelerate engineering productivity.'
      }
    ],
    tags: ['Keycloak RHBK', 'Red Hat SSO', 'Java / Spring Boot', 'Crystal Reports', 'Agentic Workflows', 'Enterprise Middleware']
  },
  {
    id: 'percept',
    company: 'Percept Solutions',
    role: 'Software Engineer',
