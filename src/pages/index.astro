    <!-- Client Script -->
    <script>
      // Theme Toggle
      const themeBtn = document.querySelector<HTMLButtonElement>('#theme-btn');
      const moonIcon = document.querySelector<HTMLElement>('#moon-icon');
      const sunIcon = document.querySelector<HTMLElement>('#sun-icon');

      function updateThemeIcons(isDark: boolean) {
        if (moonIcon && sunIcon) {
          moonIcon.style.display = isDark ? 'none' : 'block';
          sunIcon.style.display = isDark ? 'block' : 'none';
        }
      }

      const initialIsDark = document.documentElement.dataset.theme === 'dark';
      updateThemeIcons(initialIsDark);

      themeBtn?.addEventListener('click', () => {
        const isDark = document.documentElement.dataset.theme === 'dark';
        const next = isDark ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
        updateThemeIcons(!isDark);
      });

      // Pipeline Stages Interactive Data
      const stagesData = [
        {
          title: 'Stage 01: Multimodal Intake & Voice Activity Detection',
          desc: 'Captures microphone audio and sensory inputs on the client device. Uses an embedded Silero VAD neural network to discriminate voice activity from ambient noise without transmitting raw audio to external servers.',
          specs: ['Latency: <15ms', 'Engine: ONNX Runtime / Flutter FFI', 'Privacy: Zero Cloud Egress', 'Bandwidth: 0 KB until speech confirmed'],
          code: `// Local VAD & Streaming Frame Buffer\nfinal vad = SileroVadEngine(sampleRate: 16000);\naudioStream.listen((chunk) async {\n  final isSpeech = await vad.evaluate(chunk);\n  if (isSpeech) {\n    speechBuffer.append(chunk);\n  } else if (speechBuffer.isNotEmpty) {\n    dispatchToWhisper(speechBuffer.flush());\n  }\n});`
        },
        {
          title: 'Stage 02: Enterprise Cloud Security & Policy Enforcement',
          desc: 'Applies zero-trust boundary validation prior to model ingestion. Sanitizes user prompts against indirect prompt injection, strips sensitive PII (tokens, auth cookies), and validates per-user rate limits and spend quotas.',
          specs: ['Security: CSP Compliance & Zero Trust', 'IAM: Keycloak RHBK SAML 2.0', 'Budget: Token Circuit Breaker', 'Audit: Centralized SIEM Telemetry'],
          code: `// Security Boundary Guard\nexport async function evaluateGuardrails(ctx: AgentContext) {\n  const piiRedacted = redactSensitiveTokens(ctx.prompt);\n  const securityResult = await scanPromptInjection(piiRedacted);\n  if (securityResult.riskScore > 0.8) {\n    throw new SecurityViolation('Potential prompt injection rejected');\n  }\n  return enforceQuotaBudget(ctx.userId, ctx.maxTokens);\n}`
        },
        {
          title: 'Stage 03: Tiered Model Reasoning & Dynamic Dispatch',
          desc: 'Routes requests dynamically based on task complexity. Lightweight classifications and local dialogues resolve entirely offline on-device; multi-step deductive plans route to frontier reasoning models (Gemini 2.5, Claude 3.5 Sonnet, DeepSeek R1).',
          specs: ['Routing: Dynamic Cost-Latency Optimization', 'Local: GGUF 4-bit / 8-bit Q4_K_M', 'Cloud: Gemini / Claude 3.5 / GPT-4o', 'Protocol: SSE Streaming Chunked HTTP/2'],
          code: `// Strategic Model Router\nif (task.isOfflineCapable && localDevice.supportsNpu) {\n  return executeLocalLlm(task.prompt, { model: 'llama-3.2-3b-q4' });\n} else {\n  return executeFrontierAgent(task.prompt, {\n    providers: ['gemini-2.5', 'claude-3.5-sonnet'],\n    fallbackThresholdMs: 1500\n  });\n}`
        },
        {
          title: 'Stage 04: Model Context Protocol (MCP) & Deterministic Tool Bus',
          desc: 'Allows reasoning models to inspect files, query databases, and trigger verified actions. All tool execution is isolated, strictly typed via JSON Schema, and transactional to permit rollbacks on failure.',
          specs: ['Protocol: Model Context Protocol (MCP)', 'Validation: Pydantic & Zod Schemas', 'Isolation: Read-Only vs Mutating Sandboxes', 'Determinism: Automated Verification Tests'],
          code: `// MCP Tool Registration & Execution\nconst tool = defineTool({\n  name: 'query_account_ledger',\n  schema: z.object({ accountId: z.string().uuid() }),\n  execute: async ({ accountId }) => {\n    const session = await keycloak.verifyToken(ctx.auth);\n    return db.queryLedger(accountId, { tenantId: session.tenantId });\n  }\n});`
        },
        {
          title: 'Stage 05: Action Commit & Real-Time Neural Voice Synthesis',
          desc: 'Commits state changes atomically and converts agent responses into natural audio chunks or live UI components with sub-200ms time-to-first-byte streaming.',
          specs: ['Audio DSP: Streaming FastTTS & ElevenLabs', 'Latency: <180ms TTFB', 'UI: Streaming JSON State Hydration', 'Persistence: Supabase / PostgreSQL'],
          code: `// Streaming Neural Voice Dispatch\nconst ttsStream = await voiceEngine.streamSynthesis({\n  textChunkStream: agent.generateTokens(),\n  voiceProfile: 'Tokyo-NPC-Dialect',\n  format: 'audio/opus'\n});\naudioSpeaker.play(ttsStream);`
        }
      ];

      const steps = Array.from(document.querySelectorAll<HTMLElement>('.pipeline-step'));
      const detailTitle = document.querySelector<HTMLElement>('#detail-title');
      const detailDesc = document.querySelector<HTMLElement>('#detail-desc');
      const detailSpecs = document.querySelector<HTMLElement>('#detail-specs');
      const detailCode = document.querySelector<HTMLElement>('#detail-code');

      steps.forEach((step) => {
        const handler = () => {
          steps.forEach((s) => s.classList.remove('active'));
          step.classList.add('active');
          const index = Number(step.dataset.step || 0);
          const data = stagesData[index];
          if (data && detailTitle && detailDesc && detailSpecs && detailCode) {
            detailTitle.textContent = data.title;
            detailDesc.textContent = data.desc;
            detailSpecs.innerHTML = data.specs.map((s) => `<span class="spec-chip">${s}</span>`).join('');
            detailCode.textContent = data.code;
          }
        };
        step.addEventListener('click', handler);
        step.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            handler();
          }
        });
      });

      // Copy Email functionality
      const copyBtn = document.querySelector<HTMLButtonElement>('#copy-email-btn');
      const copyText = document.querySelector<HTMLElement>('#copy-text');
      copyBtn?.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText('ajithberlin10@gmail.com');
          if (copyText) {
            copyText.textContent = 'Copied to clipboard!';
            setTimeout(() => {
              copyText.textContent = 'Copy Email';
            }, 2000);
          }
        } catch {
          window.location.href = 'mailto:ajithberlin10@gmail.com';
        }
      });

      // Repository search & filter
      const filterBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter-btn'));
      const repoSearch = document.querySelector<HTMLInputElement>('#repo-search');
      const repoCards = Array.from(document.querySelectorAll<HTMLElement>('.repo-card'));

      let activeOwner = 'all';

      function filterRepos() {
        const query = repoSearch?.value.trim().toLowerCase() || '';
        repoCards.forEach((card) => {
          const owner = card.dataset.owner || '';
          const searchData = card.dataset.search || '';
          const matchesOwner = activeOwner === 'all' || owner === activeOwner;
          const matchesQuery = !query || searchData.includes(query);
          card.style.display = matchesOwner && matchesQuery ? 'flex' : 'none';
        });
      }

      filterBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          filterBtns.forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          activeOwner = btn.dataset.owner || 'all';
          filterRepos();
        });
      });

      repoSearch?.addEventListener('input', filterRepos);
    </script>
  </body>
