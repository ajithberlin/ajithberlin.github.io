---
import '../styles/global.css';
import snapshot from '../data/repos.json';
const repos = snapshot.repos.filter(r => r.name !== '.github').sort((a,b) => Number(a.fork) - Number(b.fork) || b.updated_at.localeCompare(a.updated_at));
const originals = repos.filter(r => !r.fork && !r.archived);
const featured = [
  { id: 'AlphBerlin/langcity-release', title: 'LangCity', category: 'PLAY YOUR WAY TO A NEW LANGUAGE', text: 'A little Tokyo. A world of conversation.', description: 'Explore a living city, meet characters, and turn Japanese practice into an adventure.', class: 'langcity', mark: 'あ', tags: ['Language learning', 'Game'] },
  { id: 'ajithberlin/bixel-native', title: 'Bixel', category: 'A HOME FOR YOUR NEXT PIXEL', text: 'Small pixels. Big possibilities.', description: 'A creative playground for pixel art, animation, and the worlds you want to build.', class: 'bixel', mark: '✳', tags: ['Creative tools', 'Swift'] },
  { id: 'AlphBerlin/local_ai_kit', title: 'Local AI Kit', category: 'INTELLIGENCE, CLOSER TO YOU', text: 'More possibility. On your device.', description: 'Local language models, voice detection, speech recognition, and synthesis through one Flutter API.', class: 'localai', mark: '◈', tags: ['On-device AI', 'Flutter'] }
].map(p => ({...p, repo: repos.find(r => r.full_name.toLowerCase() === p.id.toLowerCase())!}));
const civic = [
  { name: 'waterbody-atlas', title: 'Waterbody Atlas', description: 'Making water resources easier to explore.', icon: '≈' },
  { name: 'transit', title: 'Transit', description: 'Open transport data. Better connected journeys.', icon: '↗' },
  { name: 'nanayam', title: 'Nanayam', description: 'Exploring transparent transactions in governance.', icon: '◎' }
];
const languages = [...new Set(repos.map(r=>r.language))].sort();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f8f2" />
    <title>Ajith Berlin — Developer, Maker & Curious Human</title>
    <meta name="description" content="The personal workspace of Ajith Berlin. Explore creative tools, language-learning adventures, on-device AI, and open projects from AlphBerlin and Bytamilan." />
    <link rel="canonical" href={Astro.site} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content="Ajith Berlin — A curious mind. A builder at heart." />
    <meta property="og:description" content="Thoughtful products. Open code. Shared progress. Explore my projects and the communities behind them." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.site} />
    <meta property="og:image" content={new URL('/social.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>try { const t=localStorage.getItem('theme'); if(t==='dark')document.documentElement.dataset.theme='dark'; } catch {}</script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="header wrap">
      <a class="brand" href="#" aria-label="Ajith Berlin home"><span class="brand-icon">a<span>↗</span></span> ajith<span class="brand-light">berlin</span><span class="brand-dot">.</span></a>
      <nav aria-label="Main navigation"><a href="#work">Work</a><a href="#opensource">Open source</a><a href="#about">About</a></nav>
      <div class="header-actions"><button id="theme" class="icon-button" aria-label="Switch color theme" title="Switch color theme">◐</button><a class="contact-button" href="#contact">Let’s connect <span>↗</span></a></div>
    </header>
    <main id="main">
      <section class="hero wrap" aria-labelledby="hero-title">
        <div class="hero-copy">
          <div class="eyebrow"><span class="live-dot"></span> DEVELOPER. MAKER. CURIOUS HUMAN.</div>
          <h1 id="hero-title">A curious mind.<br/>A builder <span class="serif">at heart.</span><svg class="underline" viewBox="0 0 340 18" aria-hidden="true"><path d="M4 13Q155 -3 332 9" /></svg></h1>
          <p class="intro">Hi, I’m Ajith Berlin <span class="hello">✳</span><br/>I turn curiosity into thoughtful products — from playful digital worlds to tools that make everyday life a little better.</p>
          <div class="hero-links"><a class="button primary" href="#work">Explore my work <span>↘</span></a><a class="text-link" href="https://github.com/ajithberlin">Find me on GitHub ↗</a></div>
          <div class="hero-foot"><span>BUILDING WITH INTENTION</span><span class="small-line"></span><span>SHARING ALONG THE WAY</span></div>
        </div>
        <div class="orbit-art" aria-hidden="true">
          <div class="orbit-label label-top">IDEAS → THINGS THAT EXIST</div>
          <svg viewBox="0 0 520 465" class="orbital">
            <defs><radialGradient id="planet" cx="35%" cy="28%"><stop offset="0" stop-color="#e4ffa3"/><stop offset=".62" stop-color="#c4ed78"/><stop offset="1" stop-color="#8cb354"/></radialGradient><pattern id="dots" width="18" height="18" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r="1" fill="#8c9a7a" opacity=".35"/></pattern></defs>
            <rect width="520" height="465" fill="url(#dots)"/>
            <circle cx="260" cy="235" r="132" fill="url(#planet)"/>
            <g fill="none" stroke="#526b3c" stroke-width="1" opacity=".32"><ellipse cx="260" cy="235" rx="132" ry="45"/><ellipse cx="260" cy="235" rx="132" ry="95"/><ellipse cx="260" cy="235" rx="45" ry="132"/><ellipse cx="260" cy="235" rx="94" ry="132"/><path d="M128 235h264M260 103v264"/></g>
            <g fill="none" stroke="#51624b" stroke-width="1.2"><ellipse cx="260" cy="235" rx="225" ry="78" transform="rotate(-32 260 235)"/><ellipse cx="260" cy="235" rx="211" ry="91" transform="rotate(40 260 235)"/></g>
            <circle cx="78" cy="344" r="8" fill="#c7ec81" stroke="#50653b"/><circle cx="439" cy="338" r="5" fill="#253722"/>
            <path d="M435 100v25m-12-12h25M75 185v17m-8-8h17" stroke="#405334" stroke-width="2"/>
            <text x="260" y="248" text-anchor="middle" font-size="61" fill="#294529" font-family="Georgia,serif" font-style="italic">hello.</text>
          </svg>
          <div class="float-chip chip-code"><span>⌘</span> build something good</div><div class="float-chip chip-heart"><span>✳</span> stay curious</div>
          <div class="art-caption"><span class="mini-avatar">AB</span><div>Always a work in progress.<br/><strong>And that’s the good part.</strong></div><span>↗</span></div>
        </div>
      </section>
      <div class="ecosystem wrap"><span>A FEW CORNERS OF MY WORLD</span><a href="https://github.com/ajithberlin">⌘ <strong>ajithberlin</strong></a><a href="https://github.com/AlphBerlin">✳ <strong>AlphBerlin</strong></a><a href="https://github.com/bytamilan"><span lang="ta">அ</span> <strong>Bytamilan</strong></a><span class="eco-note">Independent ideas. Shared possibilities.</span></div>
      <section class="section wrap" id="work">
        <div class="section-heading"><div><p class="eyebrow">01 / SELECTED WORK</p><h2>Ideas out <span class="serif">in the world.</span></h2></div><p>A few things I’m building,<br/>learning from, and putting out there.</p></div>
        <div class="featured-grid">{featured.map((p, i) => <article class:list={['project', p.class]}>
          <a class="project-art" href={p.repo.homepage || p.repo.url} aria-label={`Explore ${p.title}`}>
            <span class="art-overline">{p.category}</span>
            <div class="project-illustration"><span class="illustration-ring"></span><span class="project-mark">{p.mark}</span>{i===0 && <><span class="jp-tag">こんにちは</span><div class="city-buildings"><i/><i/><i/><i/><i/></div></>}{i===1 && <div class="pixel-blocks">{Array.from({length:25}, (_,j)=><i class={`pixel p${j}`}/>)}</div>}{i===2 && <><span class="signal s1"></span><span class="signal s2"></span><span class="signal s3"></span><span class="ai-caption">LOCAL FIRST. POSSIBILITIES EVERYWHERE.</span></>}</div>
            <span class="art-title">{p.title}<span>↗</span></span>
          </a>
          <div class="project-body"><div class="tags">{p.tags.map(tag=><span>{tag}</span>)}</div><h3>{p.text}</h3><p>{p.description}</p><a class="text-link" href={p.repo.url}>Explore repository <span>↗</span></a></div>
        </article>)}</div>
      </section>
      <section class="community wrap" aria-labelledby="community-title">
        <div class="community-intro"><p class="eyebrow">CODE WITH A COMMUNITY IN MIND</p><h2 id="community-title">Built to be <span class="serif">shared.</span></h2><p>Through Bytamilan, I explore how open technology can make public information more useful, accessible, and transparent.</p><a class="text-link" href="https://github.com/bytamilan">Discover Bytamilan ↗</a></div>
        <div class="civic-projects">{civic.map(p=><a href={`https://github.com/bytamilan/${p.name}`}><span class="civic-icon">{p.icon}</span><span><strong>{p.title}</strong><small>{p.description}</small></span><span class="arrow">↗</span></a>)}</div>
      </section>
      <section class="section wrap" id="opensource">
        <div class="section-heading"><div><p class="eyebrow">02 / THE OPEN WORKSPACE</p><h2>Follow the <span class="serif">curiosity.</span></h2></div><p>Projects, experiments, and useful little things.<br/>Across my profile and both organizations.</p></div>
        <div class="repo-toolbar" id="repo-controls" hidden>
          <div class="filters" role="group" aria-label="Filter repositories by account"><button class="active" data-owner="all" aria-pressed="true">All projects <span>{originals.length}</span></button><button data-owner="ajithberlin" aria-pressed="false">Personal</button><button data-owner="alphberlin" aria-pressed="false">AlphBerlin</button><button data-owner="bytamilan" aria-pressed="false">Bytamilan</button></div>
          <label class="search"><span aria-hidden="true">⌕</span><input id="search" type="search" placeholder="Find a project…" aria-label="Search repositories" /></label>
        </div>
        <div class="repo-options" id="repo-options" hidden><div><label>Language <select id="language"><option value="all">All languages</option>{languages.map(l=><option>{l}</option>)}</select></label><label>Sort <select id="sort"><option value="updated">Recently updated</option><option value="stars">Most starred</option><option value="name">Name A–Z</option></select></label></div><label><input type="checkbox" id="include-forks"/> Include forks & archived</label></div>
        <p class="results" id="results" aria-live="polite">{repos.length} public repositories · GitHub snapshot {new Date(snapshot.updatedAt).toLocaleDateString('en-GB', {day:'numeric',month:'short',year:'numeric', timeZone:'UTC'})}</p>
        <div class="repo-grid" id="repo-grid">{repos.map(r=><article class="repo-card" data-owner={r.owner.toLowerCase()} data-search={`${r.name} ${r.description} ${r.topics.join(' ')} ${r.language}`.toLowerCase()} data-language={r.language} data-extra={String(r.fork || r.archived)} data-stars={r.stars} data-updated={r.updated_at} data-name={r.name}>
          <div class="repo-top"><span>⌘ {r.owner}</span><span>{r.fork ? 'Fork' : r.archived ? 'Archived' : 'Public'}</span></div><h3><a href={r.url}>{r.name}<span>↗</span></a></h3><p>{r.description || 'Explore the source, follow its progress, and see what’s taking shape.'}</p><div class="repo-bottom"><span><i class:list={['language-dot', r.language.toLowerCase()]}/>{r.language}</span><span aria-label={`${r.stars} stars`}>☆ {r.stars}</span><span aria-label={`${r.forks} forks`}>⑂ {r.forks}</span></div>
        </article>)}</div>
        <div class="empty" id="empty" hidden>No projects match those filters. <button id="reset">Reset filters ↗</button></div>
        <button id="show-more" class="button more" hidden>Show more projects ↓</button>
        <noscript><p class="results">All public repositories are shown. Enable JavaScript to search and filter.</p></noscript>
        <p class="data-note">Public repositories only. Refreshed daily from GitHub. <a href="https://github.com/ajithberlin/ajithberlin.github.io/actions">View updates ↗</a></p>
      </section>
      <section class="about wrap" id="about"><div><p class="eyebrow">03 / THE HUMAN BEHIND THE CODE</p><h2>Many interests.<br/><span class="serif">One curious mind.</span></h2></div><div><p class="about-lead">I’m a developer, entrepreneur, and lifelong learner who enjoys making useful things — and making the process a little more playful.</p><p>My work moves between full-stack products, creative tools, AI, and open technology. AlphBerlin is where many of those ideas take shape. Bytamilan brings that same curiosity to community-focused projects.</p><div class="interests"><span>Thoughtful products</span><span>Creative coding</span><span>Open technology</span><span>Always learning</span></div><a class="text-link" href="https://alphberlin.com">More from my world ↗</a></div></section>
      <section class="contact wrap" id="contact"><div><p class="eyebrow">GOOD THINGS START WITH A CONVERSATION</p><h2>Have an idea?<br/><span class="serif">Let’s make it happen.</span></h2></div><a class="button primary" href="mailto:ajithberlin@gmail.com">Say hello <span>↗</span></a><span class="contact-star" aria-hidden="true">✳</span></section>
    </main>
    <footer class="wrap"><a class="brand" href="#">ajithberlin<span class="brand-dot">.</span></a><p>© {new Date().getFullYear()} Ajith Berlin · Made with curiosity & care.</p><div><a href="https://github.com/ajithberlin">GitHub ↗</a><a href="https://alphberlin.com">AlphBerlin ↗</a><a href="#main">Back to top ↑</a></div></footer>
    <script>
      const theme = document.querySelector<HTMLButtonElement>('#theme')!;
      theme.addEventListener('click', () => { const value=document.documentElement.dataset.theme === 'dark' ? 'light':'dark';document.documentElement.dataset.theme=value;try{localStorage.setItem('theme',value)}catch{} });
      const grid=document.querySelector<HTMLElement>('#repo-grid')!;
      const cards=Array.from(grid.querySelectorAll<HTMLElement>('.repo-card'));
      const search=document.querySelector<HTMLInputElement>('#search')!;
      const language=document.querySelector<HTMLSelectElement>('#language')!;
      const sort=document.querySelector<HTMLSelectElement>('#sort')!;
      const extras=document.querySelector<HTMLInputElement>('#include-forks')!;
      const more=document.querySelector<HTMLButtonElement>('#show-more')!;
      const ownerButtons=Array.from(document.querySelectorAll<HTMLButtonElement>('[data-owner]:not(article)'));
      let owner='all',limit=9;
      function render(reset=true){
        if(reset)limit=9;
        const query=search.value.trim().toLowerCase();
        const matches=cards.filter(c=>(owner==='all'||c.dataset.owner===owner)&&(language.value==='all'||c.dataset.language===language.value)&&(!query||c.dataset.search!.includes(query))&&(extras.checked||c.dataset.extra==='false'));
        matches.sort((a,b)=>sort.value==='name'?a.dataset.name!.localeCompare(b.dataset.name!):sort.value==='stars'?Number(b.dataset.stars)-Number(a.dataset.stars):b.dataset.updated!.localeCompare(a.dataset.updated!));
        cards.forEach(c=>{c.hidden=true});matches.forEach((c,i)=>{grid.append(c);c.hidden=i>=limit});
        document.querySelector('#results')!.textContent=`Showing ${Math.min(limit,matches.length)} of ${matches.length} repositories`;
        document.querySelector<HTMLElement>('#empty')!.hidden=matches.length>0;more.hidden=matches.length<=limit;
      }
      ownerButtons.forEach(b=>b.addEventListener('click',()=>{owner=b.dataset.owner!;ownerButtons.forEach(btn=>{const active=btn===b;btn.classList.toggle('active',active);btn.setAttribute('aria-pressed',String(active))});render()}));
      search.addEventListener('input',()=>render());[language,sort,extras].forEach(el=>el.addEventListener('change',()=>render()));
      more.addEventListener('click',()=>{limit+=9;render(false)});
      document.querySelector('#reset')!.addEventListener('click',()=>{search.value='';language.value='all';sort.value='updated';extras.checked=false;ownerButtons[0].click()});
      document.querySelector<HTMLElement>('#repo-controls')!.hidden=false;document.querySelector<HTMLElement>('#repo-options')!.hidden=false;render();
    </script>
  </body>
</html>
