---
import '../styles/global.css';
import snapshot from '../data/repos.json';

const repos = snapshot.repos
  .filter(r => r.name !== '.github')
  .sort((a, b) => Number(a.fork) - Number(b.fork) || b.updated_at.localeCompare(a.updated_at));

const originals = repos.filter(r => !r.fork && !r.archived);

const techChips = [
  { name: 'Gemini 2.5', cat: 'ai' },
  { name: 'Claude 3.5', cat: 'ai' },
  { name: 'DeepSeek R1', cat: 'ai' },
  { name: 'Llama 3.3', cat: 'ai' },
  { name: 'ONNX Runtime', cat: 'ai' },
  { name: 'Silero VAD', cat: 'ai' },
  { name: 'Keycloak RHBK', cat: 'cloud' },
  { name: 'AWS & GCP', cat: 'cloud' },
  { name: 'SAML 2.0 / OIDC', cat: 'cloud' },
  { name: 'Swift & Metal', cat: 'lang' },
  { name: 'Rust C-ABI', cat: 'lang' },
  { name: 'Flutter & Dart', cat: 'lang' },
  { name: 'TypeScript', cat: 'lang' },
  { name: 'Python & PyTorch', cat: 'lang' },
  { name: 'FastAPI', cat: 'lang' }
];

const timelineEntries = [
  { company: 'Base Camp Digital', role: 'Middleware Engineer', period: '2025–Present', note: 'RHBK Keycloak & AI Workflows' },
  { company: 'Percept Solutions', role: 'Software Engineer', period: '2023–2025', note: '200K+ Users · SAML 2.0 · AWS' },
  { company: 'Zoho Corporation', role: 'Member Technical Staff', period: '2020–2023', note: 'Endpoint Central · 35+ Releases' },
  { company: 'Anna University', role: 'B.Tech (Honours)', period: '2016–2020', note: 'CGPA 8.42 · Tech President' }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#090b0e" />
    <title>Ajith Berlin — Systems & AI Engineer</title>
    <meta name="description" content="Senior Software Engineer & Certified Cloud Security Engineer. Minimalist UI for on-device AI runtimes, agentic systems, and secure middleware." />
    <link rel="canonical" href={Astro.site} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light') {
          document.documentElement.dataset.theme = 'light';
        }
      } catch {}
    </script>
  </head>
  <body>
    <!-- Subtle Background Ambient Grid -->
    <div class="bg-grid" aria-hidden="true"></div>
    <div class="bg-ambient" aria-hidden="true"></div>

    <!-- Floating OS Glass Dock -->
    <header class="dock-header wrap">
      <nav class="dock" aria-label="Quick Actions">
        <div class="dock-brand">
          <span class="dock-status-dot"></span>
          <span>Ajith Berlin</span>
        </div>

        <div class="dock-nav">
          <a class="dock-link" href="#work">Work</a>
          <a class="dock-link" href="#architecture">Architecture</a>
          <a class="dock-link" href="#experience">History</a>
        </div>

        <span class="dock-divider"></span>

        <a class="dock-btn" href="/Ajith_Berlin_Resume.pdf" target="_blank" rel="noopener noreferrer" title="View Resume">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          <span>CV</span>
        </a>

        <a class="dock-btn" href="/Ajith_Berlin_Resume.pdf" download="Ajith_Berlin_Resume.pdf" title="Download Resume">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        </a>

        <button id="copy-quick-email" class="dock-btn" title="Copy Email">
          <svg id="copy-dock-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          <span id="copy-dock-text">Email</span>
        </button>

        <button id="theme-toggle" class="icon-btn" aria-label="Toggle Theme" title="Toggle Theme">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
        </button>
      </nav>
    </header>

    <main class="wrap">
      <!-- Top Bento Section -->
      <section class="bento-grid">
        <!-- Hero Cell -->
        <div class="bento-card hero-main">
          <div class="card-label">
            <span class="dock-status-dot"></span>
            <span>Senior Software Engineer · Singapore</span>
          </div>

          <div class="hero-title-row">
            <h1 class="hero-name">Ajith Berlin</h1>
          </div>

          <span class="hero-role">Professional Cloud Security Engineer (Certified)</span>
          <p class="hero-sub">Systems middleware, on-device SLMs, and deterministic agent orchestration.</p>

          <div class="hero-controls">
            <a class="dock-btn primary" href="mailto:ajithberlin10@gmail.com">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              <span>ajithberlin10@gmail.com</span>
            </a>

            <a class="dock-btn" href="https://github.com/ajithberlin" target="_blank" rel="noopener noreferrer">
              <span>GitHub</span>
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
            </a>

            <a class="dock-btn" href="https://linkedin.com/in/ajithberlin/" target="_blank" rel="noopener noreferrer">
              <span>LinkedIn</span>
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
            </a>
          </div>
        </div>

        <!-- Live Terminal Simulator -->
        <div class="bento-card hero-terminal">
          <div class="terminal-header">
            <div class="terminal-dots">
              <span class="t-dot"></span><span class="t-dot"></span><span class="t-dot"></span>
            </div>
            <span>agent_runtime.sh</span>
          </div>

          <div class="terminal-body" id="term-stream">
            <p><span class="term-cmd">&gt;</span> runtime.init(mode: "deterministic")</p>
            <p class="term-out">[ok] Keycloak RHBK auth verified</p>
            <p><span class="term-cmd">&gt;</span> vad.stream(source: "mic_input")</p>
            <p class="term-out">[ok] Silero VAD speech confirmed (0 cloud egress)</p>
            <p><span class="term-cmd">&gt;</span> dispatch(tools: ["mcp_router", "onnx_tts"])<span class="term-cursor"></span></p>
          </div>
        </div>

        <!-- Metrics Row -->
        <div class="bento-card metric-card">
          <span class="card-label">Experience</span>
          <div class="metric-val">6+ Yrs</div>
          <span class="metric-desc">Production Systems</span>
        </div>

        <div class="bento-card metric-card">
          <span class="card-label">IAM Scale</span>
          <div class="metric-val">200K+</div>
          <span class="metric-desc">Enterprise Users</span>
        </div>

        <div class="bento-card metric-card">
          <span class="card-label">Security</span>
          <div class="metric-val">GCP</div>
          <span class="metric-desc">Certified Security Eng</span>
        </div>

        <div class="bento-card metric-card">
          <span class="card-label">Hackathons</span>
          <div class="metric-val">3x</div>
          <span class="metric-desc">RevenueCat · Meta · PayPal</span>
        </div>
      </section>

      <!-- Projects Grid (Minimalistic Bento UI) -->
      <section class="bento-grid" id="work">
        <!-- OpenBixel -->
        <div class="bento-card project-bento">
          <div>
            <div class="card-top">
              <span class="card-label">Web Tool</span>
              <span class="card-badge">Canvas API</span>
            </div>

            <!-- Interactive Mini Pixel Canvas -->
            <div class="interactive-preview-box" id="pixel-box" title="Click or hover to toggle pixels">
              <div class="pixel-canvas" id="canvas-grid">
                <!-- 64 pixels generated via script -->
              </div>
            </div>

            <div class="project-title-row">
              <h3>OpenBixel</h3>
            </div>
            <p class="project-desc-mini">Web pixel art and sprite animation studio. Built with raw Canvas API and zero dependencies.</p>
          </div>

          <div class="project-bottom-bar">
            <a href="https://alphberlin.github.io/openbixel/" target="_blank" rel="noopener noreferrer">
              <span>Launch Studio</span>
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
            </a>
            <a href="https://github.com/AlphBerlin/openbixel" target="_blank" rel="noopener noreferrer">Source</a>
          </div>
        </div>

        <!-- LangCity -->
        <div class="bento-card project-bento">
          <div>
            <div class="card-top">
              <span class="card-label">AI Game</span>
              <span class="card-badge">Shipaton</span>
            </div>

            <!-- Audio Waveform Visualizer Preview -->
            <div class="interactive-preview-box">
              <div class="wave-bars">
                <span class="w-bar"></span><span class="w-bar"></span><span class="w-bar"></span>
                <span class="w-bar"></span><span class="w-bar"></span><span class="w-bar"></span>
                <span class="w-bar"></span><span class="w-bar"></span>
              </div>
            </div>

            <div class="project-title-row">
              <h3>LangCity</h3>
            </div>
            <p class="project-desc-mini">Pixel-art Japanese learning RPG with adaptive conversational NPCs. Flutter, Flame & Supabase.</p>
          </div>

          <div class="project-bottom-bar">
            <a href="https://langcity.alphberlin.com/" target="_blank" rel="noopener noreferrer">
              <span>Live Game</span>
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
            </a>
            <a href="https://github.com/AlphBerlin/langcity-release" target="_blank" rel="noopener noreferrer">Source</a>
          </div>
        </div>

        <!-- Local AI Kit -->
        <div class="bento-card project-bento">
          <div>
            <div class="card-top">
              <span class="card-label">Edge AI</span>
              <span class="card-badge">ONNX</span>
            </div>

            <!-- Interactive Quantization Selector -->
            <div class="interactive-preview-box">
              <div class="quant-pills">
                <span class="q-pill active">Q4_K_M</span>
                <span class="q-pill">Q8_0</span>
                <span class="q-pill">FP16</span>
              </div>
            </div>

            <div class="project-title-row">
              <h3>Local AI Kit</h3>
            </div>
            <p class="project-desc-mini">Private on-device Flutter runtime. Quantized LLMs, Silero VAD, Whisper STT & neural voice.</p>
          </div>

          <div class="project-bottom-bar">
            <a href="https://alphberlin.github.io/local_ai_kit/" target="_blank" rel="noopener noreferrer">
              <span>API Docs</span>
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
            </a>
            <a href="https://github.com/AlphBerlin/local_ai_kit" target="_blank" rel="noopener noreferrer">Source</a>
          </div>
        </div>
      </section>

      <!-- Deep Strategic AI Pipeline (Like UI) -->
      <section class="bento-grid" id="architecture">
        <div class="bento-card pipeline-card">
          <div class="card-top">
            <span class="card-label">AI Pipeline Execution Graph</span>
            <span class="card-badge">Deterministic Tool Loop</span>
          </div>

          <!-- Clickable Stage Nodes -->
          <div class="pipeline-nodes-row" id="pipe-nodes">
            <button class="pipe-node-btn active" data-idx="0">
              <div class="pipe-node-top"><span>01</span><span>&lt;15ms</span></div>
              <strong class="pipe-node-name">Local VAD</strong>
              <span class="pipe-node-meta">Silero ONNX</span>
            </button>

            <button class="pipe-node-btn" data-idx="1">
              <div class="pipe-node-top"><span>02</span><span>Zero-Trust</span></div>
              <strong class="pipe-node-name">Security Gate</strong>
              <span class="pipe-node-meta">PII & Budget</span>
            </button>

            <button class="pipe-node-btn" data-idx="2">
              <div class="pipe-node-top"><span>03</span><span>Hybrid</span></div>
              <strong class="pipe-node-name">Model Router</strong>
              <span class="pipe-node-meta">Edge vs Frontier</span>
            </button>

            <button class="pipe-node-btn" data-idx="3">
              <div class="pipe-node-top"><span>04</span><span>Typed</span></div>
              <strong class="pipe-node-name">MCP Tools</strong>
              <span class="pipe-node-meta">Pydantic / Zod</span>
            </button>

            <button class="pipe-node-btn" data-idx="4">
              <div class="pipe-node-top"><span>05</span><span>Stream</span></div>
              <strong class="pipe-node-name">Synthesis</strong>
              <span class="pipe-node-meta">FastAPI & Audio</span>
            </button>
          </div>

          <!-- Dynamic Spec HUD -->
          <div class="pipe-display-pane" id="pipe-display">
            <div>
              <strong style="font-size: 13px;" id="pipe-title">01 / Local Voice Activity Detection</strong>
              <p style="font-size: 11px; color: var(--text-muted); margin-top: 2px;" id="pipe-desc">
                Sub-15ms local neural voice isolation via Silero VAD in ONNX Runtime. Zero cloud egress.
              </p>
            </div>
            <div class="pipe-specs" id="pipe-specs">
              <span class="pipe-spec-item">Latency: <strong>&lt;15ms</strong></span>
              <span class="pipe-spec-item">RAM: <strong>14 MB</strong></span>
              <span class="pipe-spec-item">Egress: <strong>0 KB</strong></span>
            </div>
          </div>
        </div>
      </section>

      <!-- History & Tech Stack (Compact UI Bento) -->
      <section class="bento-grid" id="experience">
        <!-- History Timeline -->
        <div class="bento-card timeline-card">
          <div class="card-top">
            <span class="card-label">Engineering History</span>
            <span class="card-badge">Singapore & India</span>
          </div>

          <div class="timeline-mini-list">
            {timelineEntries.map(e => (
              <div class="t-item">
                <div class="t-item-left">
                  <strong>{e.company}</strong>
                  <small>{e.role} · {e.note}</small>
                </div>
                <span class="t-item-right">{e.period}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Stack Matrix -->
        <div class="bento-card stack-card">
          <div class="card-top">
            <span class="card-label">Production Stack</span>
            <span class="card-badge">Verified</span>
          </div>

          <div class="stack-chips-grid">
            {techChips.map(c => (
              <span class="tech-chip">{c.name}</span>
            ))}
          </div>
        </div>

        <!-- Direct Contact Dock Card -->
        <div class="bento-card contact-dock-card" id="contact">
          <div class="contact-dock-left">
            <h3>Direct Contact</h3>
            <p>Singapore · +65 85315853 · ajithberlin10@gmail.com</p>
          </div>

          <div class="contact-dock-actions">
            <button id="copy-action-btn" class="dock-btn primary">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              <span id="copy-action-text">Copy Email</span>
            </button>

            <a class="dock-btn" href="/Ajith_Berlin_Resume.pdf" target="_blank" rel="noopener noreferrer">
              <span>View Resume</span>
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
            </a>

            <a class="dock-btn" href="/Ajith_Berlin_Resume.pdf" download="Ajith_Berlin_Resume.pdf">
              <span>Download</span>
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            </a>
          </div>
        </div>
      </section>

      <!-- Minimal Footer -->
      <footer class="footer-row">
        <span>Ajith Berlin · Professional Cloud Security Engineer</span>
        <div style="display: flex; gap: 14px;">
          <a href="https://github.com/ajithberlin" target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href="https://linkedin.com/in/ajithberlin/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a href="https://alphberlin.com" target="_blank" rel="noopener noreferrer">AlphBerlin</a>
          <a href="#">Top ↑</a>
        </div>
      </footer>
    </main>

    <!-- Interactive Client Script -->
    <script>
      // Pixel Canvas interactive generator
      const grid = document.getElementById('canvas-grid');
      if (grid) {
        for (let i = 0; i < 64; i++) {
          const cell = document.createElement('span');
          cell.className = 'p-cell' + (i === 18 || i === 21 || i === 26 || i === 29 || i === 42 || i === 45 || i === 50 || i === 53 ? ' lit' : '');
          cell.addEventListener('mouseenter', () => cell.classList.toggle('lit'));
          cell.addEventListener('click', () => cell.classList.toggle('lit'));
          grid.appendChild(cell);
        }
      }

      // Pipeline Graph interactive switcher
      const pipeStages = [
        {
          title: '01 / Local Voice Activity Detection',
          desc: 'Sub-15ms local neural voice isolation via Silero VAD in ONNX Runtime. Zero cloud egress.',
          specs: [['Latency', '<15ms'], ['RAM', '14 MB'], ['Egress', '0 KB']]
        },
        {
          title: '02 / Cloud Security & Guardrails',
          desc: 'CSP sanitization, prompt injection isolation, token quota circuit-breakers, Keycloak SAML verification.',
          specs: [['Security', 'Zero Trust'], ['IAM', 'Keycloak RHBK'], ['Policy', 'Hardened']]
        },
        {
          title: '03 / Strategic Hybrid Model Router',
          desc: 'Dynamic dispatch: lightweight tasks to local GGUF SLMs, multi-step reasoning to Gemini 2.5 & Claude 3.5.',
          specs: [['Local', 'GGUF Q4_K_M'], ['Frontier', 'Gemini / Claude'], ['TTFB', '180ms']]
        },
        {
          title: '04 / MCP Deterministic Tool Bus',
          desc: 'Strictly typed JSON schemas (Pydantic / Zod) executing isolated actions with transactional rollbacks.',
          specs: [['Protocol', 'Model Context Protocol'], ['Contracts', 'Zod / Pydantic'], ['State', 'Atomic']]
        },
        {
          title: '05 / Action Commit & Neural Synthesis',
          desc: 'FastAPI streaming audio synthesis and live state hydration with sub-200ms time-to-first-chunk.',
          specs: [['Audio DSP', 'PyTorch / Opus'], ['Latency', '<200ms'], ['Stream', 'WebSocket']]
        }
      ];

      const pipeButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.pipe-node-btn'));
      const pipeTitle = document.getElementById('pipe-title');
      const pipeDesc = document.getElementById('pipe-desc');
      const pipeSpecs = document.getElementById('pipe-specs');

      pipeButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          pipeButtons.forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          const data = pipeStages[Number(btn.dataset.idx || 0)];
          if (data && pipeTitle && pipeDesc && pipeSpecs) {
            pipeTitle.textContent = data.title;
            pipeDesc.textContent = data.desc;
            pipeSpecs.innerHTML = data.specs.map(([k, v]) => `<span class="pipe-spec-item">${k}: <strong>${v}</strong></span>`).join('');
          }
        });
      });

      // Quantization pills toggle
      const qPills = Array.from(document.querySelectorAll<HTMLElement>('.q-pill'));
      qPills.forEach((p) => {
        p.addEventListener('click', () => {
          qPills.forEach((x) => x.classList.remove('active'));
          p.classList.add('active');
        });
      });

      // Copy email handlers
      async function copyEmail(btnId: string, textId: string) {
        const textEl = document.getElementById(textId);
        try {
          await navigator.clipboard.writeText('ajithberlin10@gmail.com');
          if (textEl) {
            textEl.textContent = 'Copied!';
            setTimeout(() => {
              textEl.textContent = textId.includes('dock') ? 'Email' : 'Copy Email';
            }, 1800);
          }
        } catch {
          window.location.href = 'mailto:ajithberlin10@gmail.com';
        }
      }

      document.getElementById('copy-quick-email')?.addEventListener('click', () => copyEmail('copy-quick-email', 'copy-dock-text'));
      document.getElementById('copy-action-btn')?.addEventListener('click', () => copyEmail('copy-action-btn', 'copy-action-text'));

      // Theme toggle
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const isLight = document.documentElement.dataset.theme === 'light';
        const next = isLight ? 'dark' : 'light';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
      });
    </script>
  </body>
</html>
